# ~/.gitconfig (symlinked)

[init]
	defaultBranch = main

[fetch]
	prune = true

[pull]
	rebase = false

[rerere]
	enabled = true

[color]
	ui = auto

[core]
	excludesfile = ~/.gitignore

[include]
	# Put machine- or identity-specific settings here (name/email, signing, etc.).
	path = ~/.gitconfig.local
