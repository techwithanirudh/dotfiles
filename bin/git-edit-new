#!/usr/bin/env bash
set -euo pipefail

# Open new, unstaged files in your editor.
# Uses $EDITOR if set, otherwise falls back to nvim/vim/vi.

editor="${EDITOR:-}"
if [[ -z "$editor" ]]; then
	if command -v nvim >/dev/null 2>&1; then
		editor="nvim"
	elif command -v vim >/dev/null 2>&1; then
		editor="vim"
	else
		editor="vi"
	fi
fi

mapfile -t files < <(git ls-files --others --exclude-standard)
if [[ ${#files[@]} -eq 0 ]]; then
	echo "no new files" >&2
	exit 0
fi

exec "$editor" "${files[@]}"
