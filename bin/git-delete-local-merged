#!/usr/bin/env bash
set -euo pipefail

# Delete local branches merged into HEAD (excluding main/master).
branches=$(git branch --merged | sed 's/^\*//g' | sed 's/^ *//g' | grep -vE '^(main|master)$' || true)
if [[ -z "$branches" ]]; then
	echo "no merged branches to delete"
	exit 0
fi

echo "$branches" | while IFS= read -r b; do
	[[ -n "$b" ]] || continue
	git branch -d "$b"
done
