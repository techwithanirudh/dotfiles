#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
DOTFILES_ROOT="$(pwd -P)"

# shellcheck source=/dev/null
source "$DOTFILES_ROOT/script/lib/index.sh"

install_dotfiles() {
	info "installing dotfiles"

	local base dst
	while IFS= read -r src; do
		base="$(basename "${src%.*}")"
		dst="$HOME/.${base}"
		if [[ "$base" == "gitconfig" && "$src" == "$DOTFILES_ROOT/git/gitconfig.symlink" ]]; then
			mkdir -p "$(dirname "$dst")"
			if [[ -f "$dst" && ! -f "$HOME/.gitconfig.local" ]]; then
				mv "$dst" "$HOME/.gitconfig.local"
				success "migrated $dst to ~/.gitconfig.local"
			elif [[ -f "$dst" ]]; then
				local backup
				backup="$(backup_path "$dst")"
				mv "$dst" "$backup"
				success "backed up $dst to $backup"
			fi
			cp -f "$src" "$dst"
			success "installed $dst"
			continue
		fi
		link_file "$src" "$dst"
	done < <(find -H "$DOTFILES_ROOT" -maxdepth 2 -name '*.symlink' -not -path '*/.git/*' | sort)
}

install_config() {
	if [[ ! -d "$DOTFILES_ROOT/config" ]]; then
		return
	fi

	info "installing config"
	mkdir -p "$HOME/.config"

	while IFS= read -r src; do
		local rel dst_dir dst
		rel="${src#"$DOTFILES_ROOT/config/"}"
		dst_dir="$HOME/.config/$(dirname "$rel")"
		dst="$HOME/.config/$rel"
		mkdir -p "$dst_dir"
		link_file "$src" "$dst"
	done < <(find -H "$DOTFILES_ROOT/config" -type f -not -path '*/.git/*' | sort)
}

install_dotfiles
install_config
success "bootstrap complete"
