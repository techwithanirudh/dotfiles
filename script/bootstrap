#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
DOTFILES_ROOT="$(pwd -P)"

source "$DOTFILES_ROOT/script/lib/log.sh"

printf "\n"

backup_path() {
	local dst="$1"
	local base="${dst}.backup"

	if [[ ! -e "$base" && ! -L "$base" ]]; then
		printf '%s' "$base"
		return
	fi

	printf '%s.%s' "$base" "$(date +%Y%m%d%H%M%S)"
}

link_file() {
	local src="$1" dst="$2"

	if [[ -L "$dst" ]]; then
		local current
		current="$(readlink "$dst" || true)"
		if [[ "$current" == "$src" ]]; then
			success "skipped $src"
			return
		fi
	fi

	if [[ -e "$dst" || -L "$dst" ]]; then
		local backup
		backup="$(backup_path "$dst")"
		if mv "$dst" "$backup"; then
			success "moved $dst to $backup"
		else
			fail "could not move $dst to $backup"
		fi
	fi

	if ln -s "$src" "$dst"; then
		success "linked $src to $dst"
	else
		fail "could not link $src to $dst"
	fi
}

install_dotfiles() {
	info "installing dotfiles"

	while IFS= read -r src; do
		local base dst
		base="$(basename "${src%.*}")"
		dst="$HOME/.${base}"
		link_file "$src" "$dst"
	done < <(find -H "$DOTFILES_ROOT" -maxdepth 2 -name '*.symlink' -not -path '*/.git/*' | sort)
}

install_config() {
	if [[ ! -d "$DOTFILES_ROOT/config" ]]; then
		return
	fi

	info "installing config"
	mkdir -p "$HOME/.config"

	while IFS= read -r src; do
		local rel dst_dir dst
		rel="${src#"$DOTFILES_ROOT/config/"}"
		dst_dir="$HOME/.config/$(dirname "$rel")"
		dst="$HOME/.config/$rel"
		mkdir -p "$dst_dir"
		link_file "$src" "$dst"
	done < <(find -H "$DOTFILES_ROOT/config" -type f -not -path '*/.git/*' | sort)
}

install_dotfiles
install_config
printf "\n"
success "All installed!"
