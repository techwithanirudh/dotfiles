#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
DOTFILES_ROOT="$(pwd -P)"

# shellcheck source=/dev/null
source "$DOTFILES_ROOT/script/lib/index.sh"

install_dotfiles() {
	info "installing dotfiles"

	local base dst
	while IFS= read -r src; do
		base="$(basename "${src%.*}")"
		dst="$HOME/.${base}"
		link_file "$src" "$dst"
	done < <(find -H "$DOTFILES_ROOT" -maxdepth 2 -name '*.symlink' -not -path '*/.git/*' | sort)
}

install_config() {
	if [[ ! -d "$DOTFILES_ROOT/config" ]]; then
		return
	fi

	info "installing config"
	mkdir -p "$HOME/.config"

	while IFS= read -r src; do
		local rel dst_dir dst
		rel="${src#"$DOTFILES_ROOT/config/"}"
		dst_dir="$HOME/.config/$(dirname "$rel")"
		dst="$HOME/.config/$rel"
		mkdir -p "$dst_dir"
		link_file "$src" "$dst"
	done < <(find -H "$DOTFILES_ROOT/config" -type f -not -path '*/.git/*' | sort)
}

install_gitconfig() {
	local dst="$HOME/.gitconfig"
	local src="$DOTFILES_ROOT/git/gitconfig"

	if [[ ! -f "$src" ]]; then
		return
	fi

	# Use [include] so ~/.gitconfig stays writable (git config --global works).
	if [[ -f "$dst" ]] && grep -q "path = $src" "$dst" 2>/dev/null; then
		success "already included $src in $dst"
		return
	fi

	# Back up existing gitconfig if it's not one we generated.
	if [[ -e "$dst" || -L "$dst" ]]; then
		local backup
		backup="$(backup_path "$dst")"
		mv "$dst" "$backup"
		success "moved $dst to $backup"
	fi

	cat > "$dst" <<-EOF
	# Generated by dotfiles bootstrap — do not symlink.
	# Machine-specific overrides (user.name, user.email, etc.) can be added
	# directly here or in ~/.gitconfig.local.
	[include]
		path = $src
	EOF
	success "generated $dst (includes $src)"
}

install_dotfiles
install_gitconfig
install_config
success "bootstrap complete"
