#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
DOTFILES_ROOT="$(pwd -P)"

# shellcheck source=/dev/null
source "$DOTFILES_ROOT/script/lib/index.sh"

install_dotfiles() {
	info "installing dotfiles"

	local base dst
	while IFS= read -r src; do
		base="$(basename "${src%.*}")"
		dst="$HOME/.${base}"
		if [[ "$base" == "gitconfig" && "$src" == "$DOTFILES_ROOT/git/gitconfig.symlink" ]]; then
			# ~/.gitconfig is a stub that includes the repo copy: dotfiles updates
			# apply live, while tools that write via `git config --global` (VS Code,
			# gh, etc.) write to the stub instead of dirtying this repo.
			local stub
			stub="$(printf '# Managed by dotfiles: settings live in the included file.\n# Local `git config --global` writes land below and override it.\n[include]\n\tpath = %s\n' "$src")"
			mkdir -p "$(dirname "$dst")"
			if [[ -L "$dst" ]]; then
				rm -f "$dst"
			fi
			if [[ -f "$dst" ]] && head -n 4 "$dst" | cmp -s - <(printf '%s\n' "$stub"); then
				success "gitconfig already includes $src"
				continue
			fi
			if [[ -f "$dst" ]]; then
				if [[ -f "$HOME/.gitconfig.local" ]]; then
					local backup
					backup="$(backup_path "$dst")"
					cp "$dst" "$backup"
					success "backed up $dst to $backup"
				else
					local key value migrated=0
					while IFS='=' read -r key value; do
						[[ -z "$key" || "$key" == include.* ]] && continue
						if [[ "$(git config --file "$src" --get "$key" 2>/dev/null || true)" != "$value" ]]; then
							git config --file "$HOME/.gitconfig.local" --add "$key" "$value"
							migrated=1
						fi
					done < <(git config --list --file "$dst" 2>/dev/null)
					[[ "$migrated" -eq 1 ]] && success "migrated machine-specific settings to ~/.gitconfig.local"
				fi
			fi
			printf '%s\n' "$stub" > "$dst"
			success "wrote $dst (includes $src)"
			continue
		fi
		if [[ "$base" == "zshrc" && "$src" == "$DOTFILES_ROOT/zsh/zshrc.symlink" ]]; then
			install_zshrc_stub "$src" "$dst"
			continue
		fi
		link_file "$src" "$dst"
	done < <(find -H "$DOTFILES_ROOT" -maxdepth 2 -name '*.symlink' -not -path '*/.git/*' | sort)
}

# ~/.zshrc is a stub that sources the repo copy, so installers (bun, nvm, ...)
# append to the stub instead of dirtying this repo.
install_zshrc_stub() {
	local src="$1" dst="$2" stub rel added
	stub="$(printf '# Managed by dotfiles: config lives in the sourced file.\n# Installers and local tweaks can append below.\nsource %s\n' "$src")"

	if [[ -f "$dst" && ! -L "$dst" ]] && head -n 3 "$dst" | cmp -s - <(printf '%s\n' "$stub"); then
		success "zshrc already sources $src"
		return
	fi

	# Rescue lines installers appended to the repo copy through the old symlink.
	# Only when the change is pure additions; anything else is left for review.
	rel="${src#"$DOTFILES_ROOT/"}"
	added=""
	local diff=""
	if git -C "$DOTFILES_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
		diff="$(git -C "$DOTFILES_ROOT" diff -U0 -- "$rel")"
	fi
	if [[ -n "$diff" ]] && ! grep -q '^-[^-]' <<<"$diff"; then
		added="$(grep '^+' <<<"$diff" | grep -v '^+++' | cut -c2-)"
		git -C "$DOTFILES_ROOT" checkout -- "$rel"
		success "moved local additions from $rel into $dst"
	fi

	if [[ -L "$dst" ]]; then
		rm -f "$dst"
	elif [[ -e "$dst" ]]; then
		local backup
		backup="$(backup_path "$dst")"
		mv "$dst" "$backup"
		success "moved $dst to $backup"
	fi

	{
		printf '%s\n' "$stub"
		if [[ -n "$added" ]]; then
			printf '%s\n' "$added"
		fi
	} > "$dst"
	success "wrote $dst (sources $src)"
}

install_config() {
	if [[ ! -d "$DOTFILES_ROOT/config" ]]; then
		return
	fi

	info "installing config"
	mkdir -p "$HOME/.config"

	while IFS= read -r src; do
		local rel dst_dir dst
		rel="${src#"$DOTFILES_ROOT/config/"}"
		dst_dir="$HOME/.config/$(dirname "$rel")"
		dst="$HOME/.config/$rel"
		mkdir -p "$dst_dir"
		link_file "$src" "$dst"
	done < <(find -H "$DOTFILES_ROOT/config" -type f -not -path '*/.git/*' | sort)
}

install_dotfiles
install_config
success "bootstrap complete"
